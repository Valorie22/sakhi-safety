# ---------------------------------------------------------------------------
# Sakhi API
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Supabase project (values for the provisioned project are in the root README)
SUPABASE_URL=https://<your-project-ref>.supabase.co

# SERVER ONLY. Bypasses RLS. Never ship this to the mobile app, never commit it.
# Supabase dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Public client key, used to validate incoming user JWTs.
SUPABASE_ANON_KEY=

# Comma separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Expo push endpoint. No credentials needed for unauthenticated Expo push.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# Signed URL lifetime for audio evidence, in seconds.
AUDIO_SIGNED_URL_TTL=120
